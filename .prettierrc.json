{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 120,
  "useTabs": false,
  "bracketSpacing": true,
  "importOrder": [
    "^node:$",
    "^(react/(.*)$)|^(react$)",
    "<THIRD_PARTY_MODULES>",
    "^\\./components/(.*)$",
    "^\\./components/common/(.*)$",
    "^\\./components/ui/(.*)$",
    "^\\./contexts$",
    "^\\./contexts/(.*)$",
    "^\\./contexts/common/(.*)$",
    "^\\./contexts/contributor/(.*)$",
    "^\\./layouts$",
    "^\\./layouts/(.*)$",
    "^\\./lib/(.*)$",
    "^\\./pages/(.*)$",
    "^\\./pages/common/(.*)$",
    "^\\./pages/contributor/(.*)$",
    "^\\./pages/public/(.*)$",
    "^\\./services/(.*)$",
    "^\\./styles/(.*)$",
    "^\\./utils/(.*)$",
    "^\\.\\./",
    "^\\.\\./[^/]+/(.*)$",
    "^\\.\\.\\./",
    "^\\.\\.\\./[^/]+/(.*)$",
    "^\\.\\.\\.\\./"
  ],
  "plugins": ["@ianvs/prettier-plugin-sort-imports"]
}